# Server-only. The browser never sees this file. Restart `npm run dev` after changing it.
BACKEND_URL=http://127.0.0.1:4000
# Public site address, used for canonical links, sitemap.xml, robots.txt, and share images. Set it before `npm run build`.
SITE_URL=http://localhost:3000
# Reown project id from https://dashboard.reown.com. Passed into the page by the server.
REOWN_API_KEY=
