# RPC used for swap quotes and on-chain token images.
# Paste your provider URL, then restart `npm run dev`.
SOLANA_RPC_URL=https://solana-rpc.publicnode.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# Optional. Falls back to the upgrade authority when empty.
# GOBLOCK_TREASURY=
# Comma-separated subscription keys for /api/v1/swap.
# GOBLOCK_API_KEYS=
