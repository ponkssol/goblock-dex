# Paid RPC for quotes and the wallet proxy. Restart `npm run dev` after changing it.
SOLANA_RPC_URL=https://your-provider.example

# Where swap fees land. The default is the buyback vault PDA, which splits them 60/40 on chain.
# It must hold at least 0.001 SOL before fees go to it.
GOBLOCK_TREASURY=7bo6FFvvfPfzcBn7tow8hhUrtXmYboeoqCaNmHBqqsaF
# Where Builder and Starter subscription payments land. Swap fees stay in the vault above.
# GOBLOCK_CHECKOUT_WALLET=Baik5ApDziz9Hzyqq6EoUFUb9jFh5AeqmFCqfGgbXy77
# Comma-separated subscription keys for /api/v1/swap. These swaps pay no goblock fee.
# GOBLOCK_API_KEYS=
# Signs free keys, dashboard keys, and dashboard sign-ins. At least 32 characters; keys stay off while empty.
# Changing it voids every key already issued and signs everyone out of /dashboard.
# GOBLOCK_KEY_SECRET=
# Postgres for dashboard keys and usage. When empty, a local PGlite database is kept in backend/.data/.
# DATABASE_URL=postgresql://user:password@host:5432/goblock
# Comma-separated free keys to refuse.
# GOBLOCK_BLOCKED_KEYS=
